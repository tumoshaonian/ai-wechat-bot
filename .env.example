WECHAT_BOT_ID=
WECHAT_BOT_SECRET=
SPRING_BOOT_URL=http://127.0.0.1:8080/api/wechat/reply
WECOM_ALLOWED_USER_IDS=
WECOM_REQUEST_TIMEOUT_SECONDS=60
WECOM_PROGRESS_INTERVAL_SECONDS=30
# 企业微信流式消息 10 分钟过期；总任务必须在过期前停止并提交结果。
WECOM_TASK_TIMEOUT_SECONDS=480
WECOM_LOG_LEVEL=INFO

# 开启后，所有自然语言消息进入统一 Agent；HARNESS_COMMAND_PREFIX 仅保留旧命令兼容。
HARNESS_ENABLED=false
HARNESS_COMMAND_PREFIX=/电脑
HARNESS_WORKSPACE=D:\a-TuMo\study\project
HARNESS_DSH_HOME=D:\a-TuMo\study\project\ai-wechat-bot\.harness-sessions
HARNESS_PROFILE=sdk
# 正式部署使用 exe（无需 Node）；本地源码调试可改为 node，但必须先构建 runtime carrier。
HARNESS_RUNTIME_MODE=exe
# 通常留空，使用 deepseek-harness-runtime-bin 自带运行时；仅自定义部署时填写 dsh 可执行文件。
HARNESS_DSH_BIN=
# sdk profile 的默认 ask 审批没有微信响应方。单用户远程全控需 danger-full-access；扩大用户范围前请勿使用。
HARNESS_PERMISSION_MODE=danger-full-access
HARNESS_PROVIDER=deepseek-official
HARNESS_MODEL=deepseek-v4-flash
HARNESS_REASONING_EFFORT=max
HARNESS_MAX_TOKENS=49152
HARNESS_INITIALIZE_TIMEOUT_SECONDS=90
HARNESS_REQUEST_TIMEOUT_SECONDS=450
HARNESS_SHUTDOWN_TIMEOUT_SECONDS=10
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Windows 结构化桌面工具。默认在 Windows 上开启；不使用桌面能力时设为 false。
DESKTOP_TOOLS_ENABLED=true
DESKTOP_ACTION_TIMEOUT_SECONDS=180
DESKTOP_SCREENSHOT_DIRECTORY=C:\Users\你的用户名\Pictures\WeComAgent
# 留空时自动查找桌面或开始菜单中的“豆包.lnk”。若豆包未暴露可访问性树，
# 第一次事务会仅重启豆包并自动加入 --force-renderer-accessibility。
DOUBAO_LAUNCH_PATH=
